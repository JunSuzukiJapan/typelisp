{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "typelisp",
  "scopeName": "source.typelisp",
  "patterns": [
    {
      "include": "#char-literal"
    },
    {
      "include": "#comment-block"
    },
    {
      "include": "#comment-line"
    },
    {
      "include": "#string"
    },
    {
      "include": "#dyn-type"
    },
    {
      "include": "#keyword-symbol"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#variable-definition"
    },
    {
      "include": "#impl"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#lambda-list"
    },
    {
      "include": "#special-form"
    },
    {
      "include": "#clause"
    },
    {
      "include": "#builtin-function"
    },
    {
      "include": "#builtin-type"
    },
    {
      "include": "#never-type"
    },
    {
      "include": "#user-type"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#number"
    },
    {
      "include": "#global-variable"
    }
  ],
  "repository": {
    "char-literal": {
      "match": "#\\\\(?:[A-Za-z][A-Za-z0-9]*|.)",
      "name": "constant.character.typelisp"
    },
    "comment-block": {
      "name": "comment.block.typelisp",
      "begin": "#\\|",
      "end": "\\|#",
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "comment-line": {
      "name": "comment.line.semicolon.typelisp",
      "begin": ";",
      "end": "$"
    },
    "string": {
      "name": "string.quoted.double.typelisp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\[ntr0\\\\\"]",
          "name": "constant.character.escape.typelisp"
        },
        {
          "match": "~(?:'.|[-+0-9,vV#:@])*(?:[\\]\\[a-zA-Z%&|~$_^<>{}();*?]|\\n)",
          "name": "constant.other.placeholder.typelisp"
        }
      ]
    },
    "dyn-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])(:dyn)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:\\s+([A-Za-z][A-Za-z0-9_-]*))?",
      "captures": {
        "1": {
          "name": "keyword.other.dyn.typelisp"
        },
        "2": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "keyword-symbol": {
      "match": "(?<![-A-Za-z0-9_:]):[A-Za-z][A-Za-z0-9_?!*<>=/+-]*",
      "name": "constant.other.symbol.typelisp"
    },
    "definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defmethod|defmacro|defun)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.function.typelisp"
        },
        "3": {
          "name": "entity.name.function.typelisp"
        }
      }
    },
    "type-definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defstruct|deftrait|defenum)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.class.typelisp"
        },
        "3": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "variable-definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defconstant|defvar)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.typelisp"
        },
        "3": {
          "name": "variable.other.definition.typelisp"
        }
      }
    },
    "impl": {
      "match": "\\(\\s*(impl(?:<[^>]*>)?)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?(?:\\s+([-A-Za-z0-9_?!*/+.%&^~:<>=]+))?",
      "captures": {
        "1": {
          "name": "keyword.control.impl.typelisp"
        },
        "2": {
          "name": "entity.name.type.typelisp"
        },
        "3": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "declaration": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:module|where|impl|load|pub|use)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.declaration.typelisp"
    },
    "lambda-list": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:\\&optional|\\&rest|\\&key)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "storage.modifier.lambda-list.typelisp"
    },
    "special-form": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:pprint\\-logical\\-block|unquote\\-splicing|pprint\\-tabular|documentation|pprint\\-linear|pprint\\-fill|unreachable|quasiquote|while\\-let|rotatef|compile|dotimes|println|unquote|doiter|dolist|format|if\\-let|labels|lambda|pprint|return|shiftf|try\\-as|unless|apply|break|match|panic|print|progn|quote|until|while|case|cond|decf|incf|let\\*|list|loop|setf|todo|when|and|let|the|as|do|if|or)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.typelisp"
    },
    "clause": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:else)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.conditional.typelisp"
    },
    "builtin-function": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:internal\\-time\\-units\\-per\\-second|pprint\\-exit\\-if\\-list\\-exhausted|make\\-string\\-output\\-stream|get\\-output\\-stream\\-string|make\\-concatenated\\-stream|make\\-string\\-input\\-stream|make\\-random\\-state\\-fresh|get\\-internal\\-real\\-time|with\\-input\\-from\\-string|make\\-broadcast\\-stream|pprint\\-list\\-exhausted|with\\-output\\-to\\-string|directory\\-namestring|make\\-two\\-way\\-stream|pathname\\-absolute\\-p|get\\-universal\\-time|pathname\\-directory|enough\\-namestring|make\\-random\\-state|random\\-state\\-copy|random\\-state\\-next|try\\-bignum\\-\\>int|write\\-file\\-string|direction\\-append|direction\\-output|make\\-echo\\-stream|make\\-peek\\-stream|parse\\-namestring|read\\-file\\-string|string\\-\\>symbol|symbol\\-\\>string|bignum\\-\\>float|bignum\\-\\>ratio|direction\\-input|file\\-namestring|float\\-\\>bignum|merge\\-pathnames|ratio\\-\\>bignum|read\\-file\\-lines|try\\-int\\-\\>char|float\\-\\>ratio|integer\\-length|pprint\\-newline|random\\-state\\-p|ratio\\-\\>float|ratio\\-expt\\-int|sexpr\\-sym\\-name|with\\-open\\-file|at\\-line\\-start|bignum\\-\\>int|byte\\-position|deposit\\-field|finish\\-output|greater\\-equal|int\\-\\>bignum|make\\-pathname|open\\-stream\\-p|pathname\\-name|pathname\\-type|pprint\\-indent|as\\-dyn\\-error|char\\->string|compile\\-file|float\\-\\>int|int\\-\\>float|int\\-\\>ratio|print\\-object|sexpr\\-append|truncate\\-div|write\\-string|ceiling\\-div|char\\-\\>int|copy\\-stream|delete\\-file|denominator|int\\-\\>char|open\\-output|parse\\-float|rename\\-file|sexpr\\-consp|sexpr\\-float|to\\-pathname|unread\\-char|write\\-lines|fresh\\-line|less\\-equal|mask\\-field|namestring|not\\-equals|open\\-input|pprint\\-pop|pprint\\-tab|probe\\-file|read\\-lines|read\\-sexpr|sexpr\\-atom|sexpr\\-bool|sexpr\\-char|sexpr\\-cons|sexpr\\-null|sexpr\\-symp|write\\-char|write\\-item|write\\-line|byte\\-size|floor\\-div|numerator|open\\-file|parse\\-int|peek\\-char|read\\-char|read\\-item|read\\-line|remove\\-if|round\\-div|sexpr\\-car|sexpr\\-cdr|sexpr\\-int|sexpr\\-map|sexpr\\-str|substring|unwrap\\-or|count\\-if|downcase|identity|keywordp|ldb\\-test|logandc1|logandc2|logcount|position|read\\-all|truncate|butlast|ceiling|compose|entries|find\\-if|greater|is\\-none|is\\-some|logbitp|lognand|logorc1|logorc2|logtest|message|reverse|alphap|append|digitp|equalp|equals|filter|gensym|is\\-err|length|logand|logeqv|logior|lognor|lognot|logxor|member|minusp|random|remove|signum|source|subseq|terpri|unwrap|upcase|values|acosh|asinh|assoc|atanh|boole|clear|close|const|count|equal|evenp|every|floor|foldl|foldr|is\\-ok|plusp|round|zerop|acos|asin|atan|byte|cons|cosh|eval|exit|expt|find|flip|iter|keys|last|less|next|oddp|push|read|sinh|sort|sqrt|take|tanh|time|abs|any|ash|car|cdr|cos|dpb|elt|eql|exp|gcd|get|lcm|ldb|len|log|map|max|min|mod|new|not|nth|pop|ref|rem|set|sin|tan|eq|lt)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "support.function.typelisp"
    },
    "builtin-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])(?:string\\-output\\-stream|concatenated\\-stream|string\\-input\\-stream|broadcast\\-stream|ParseFloatError|standard\\-stream|hashtable\\-iter|two\\-way\\-stream|ParseIntError|outputstream|random\\-state|echo\\-stream|inputstream|peek\\-stream|vector\\-iter|charoutput|EvalError|HashTable|ReadError|charinput|cons\\-cell|fileerror|peekinput|pathname|pathish|Option|Result|Vector|bignum|stream|string|symbol|Error|Sexpr|isize|ratio|usize|Iter|Self|bool|char|Ord|f32|f64|i16|i32|i64|u16|u32|u64|Eq|i8|u8)(?![-A-Za-z0-9_?!*/+.%&^~:])",
      "name": "support.type.typelisp"
    },
    "never-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])!(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "support.type.never.typelisp"
    },
    "user-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])[A-Z][A-Za-z0-9_]*",
      "name": "entity.name.type.typelisp"
    },
    "constant": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:boole\\-andc1|boole\\-andc2|boole\\-nand|boole\\-orc1|boole\\-orc2|boole\\-and|boole\\-clr|boole\\-eqv|boole\\-ior|boole\\-nor|boole\\-set|boole\\-xor|boole\\-c1|boole\\-c2|boole\\-1|boole\\-2|false|pi|true)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "constant.language.typelisp"
    },
    "number": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])[-+]?(?:0[xX][0-9a-fA-F]+|[0-9]+/[0-9]+|[0-9]+\\.[0-9]+(?:[eE][-+]?[0-9]+)?|[0-9]+[eE][-+]?[0-9]+|[0-9]+)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "constant.numeric.typelisp"
    },
    "global-variable": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])\\*[A-Za-z0-9?!*<>=/+-]+\\*(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "variable.other.global.typelisp"
    }
  }
}
