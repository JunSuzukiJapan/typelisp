{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "typelisp",
  "scopeName": "source.typelisp",
  "patterns": [
    {
      "include": "#char-literal"
    },
    {
      "include": "#comment-block"
    },
    {
      "include": "#comment-line"
    },
    {
      "include": "#string"
    },
    {
      "include": "#dyn-type"
    },
    {
      "include": "#keyword-symbol"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#variable-definition"
    },
    {
      "include": "#impl"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#lambda-list"
    },
    {
      "include": "#special-form"
    },
    {
      "include": "#clause"
    },
    {
      "include": "#builtin-function"
    },
    {
      "include": "#builtin-type"
    },
    {
      "include": "#never-type"
    },
    {
      "include": "#user-type"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#number"
    },
    {
      "include": "#global-variable"
    }
  ],
  "repository": {
    "char-literal": {
      "match": "#\\\\(?:[A-Za-z][A-Za-z0-9]*|.)",
      "name": "constant.character.typelisp"
    },
    "comment-block": {
      "name": "comment.block.typelisp",
      "begin": "#\\|",
      "end": "\\|#",
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "comment-line": {
      "name": "comment.line.semicolon.typelisp",
      "begin": ";",
      "end": "$"
    },
    "string": {
      "name": "string.quoted.double.typelisp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\[ntr0\\\\\"]",
          "name": "constant.character.escape.typelisp"
        },
        {
          "match": "~(?:'.|[-+0-9,vV#:@])*(?:[\\]\\[a-zA-Z%&|~$_^<>{}();*?]|\\n)",
          "name": "constant.other.placeholder.typelisp"
        }
      ]
    },
    "dyn-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])(:dyn)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:\\s+([A-Za-z][A-Za-z0-9_-]*))?",
      "captures": {
        "1": {
          "name": "keyword.other.dyn.typelisp"
        },
        "2": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "keyword-symbol": {
      "match": "(?<![-A-Za-z0-9_:]):[A-Za-z][A-Za-z0-9_?!*<>=/+-]*",
      "name": "constant.other.symbol.typelisp"
    },
    "definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defsignature|defmethod|defmacro|defun)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.function.typelisp"
        },
        "3": {
          "name": "entity.name.function.typelisp"
        }
      }
    },
    "type-definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defstruct|deftrait|defenum|deftype)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.class.typelisp"
        },
        "3": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "variable-definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defparameter|defconstant|defvar)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.typelisp"
        },
        "3": {
          "name": "variable.other.definition.typelisp"
        }
      }
    },
    "impl": {
      "match": "\\(\\s*(impl(?:<[^>]*>)?)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?(?:\\s+([-A-Za-z0-9_?!*/+.%&^~:<>=]+))?",
      "captures": {
        "1": {
          "name": "keyword.control.impl.typelisp"
        },
        "2": {
          "name": "entity.name.type.typelisp"
        },
        "3": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "declaration": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:shadowing\\-import|in\\-module|module|import|where|impl|load|pub|use)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.declaration.typelisp"
    },
    "lambda-list": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:\\&optional|\\&rest|\\&key)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "storage.modifier.lambda-list.typelisp"
    },
    "special-form": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:pprint\\-logical\\-block|unquote\\-splicing|symbol\\-macrolet|pprint\\-tabular|unwind\\-protect|documentation|pprint\\-linear|pprint\\-fill|unreachable|return\\-from|source\\-file|quasiquote|while\\-let|macrolet|compile|dotimes|println|rotatef|unquote|doiter|dolist|format|if\\-let|labels|lambda|pprint|return|shiftf|try\\-as|unless|apply|block|break|catch|ccase|ecase|match|panic|print|prog1|prog2|progn|psetf|psetq|quote|throw|until|while|case|cond|decf|incf|let\\*|list|loop|setf|setq|todo|when|and|do\\*|let|the|as|do|if|or)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.typelisp"
    },
    "clause": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:else)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.conditional.typelisp"
    },
    "builtin-function": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:read\\-from\\-string\\-preserving\\-whitespace|read\\-sexpr\\-preserving\\-whitespace|internal\\-time\\-units\\-per\\-second|pprint\\-exit\\-if\\-list\\-exhausted|set\\-dispatch\\-macro\\-character|get\\-dispatch\\-macro\\-character|lisp\\-implementation\\-version|make\\-string\\-output\\-stream|get\\-output\\-stream\\-string|make\\-string\\-input\\-stream|ensure\\-directories\\-exist|lisp\\-implementation\\-type|make\\-concatenated\\-stream|make\\-random\\-state\\-fresh|set\\-macro\\-character|get\\-macro\\-character|destructuring\\-bind|seed\\-random\\-state|with\\-standard\\-io\\-syntax|get\\-internal\\-real\\-time|get\\-internal\\-run\\-time|timezone\\-offset\\-seconds|timezone\\-daylight\\-p|with\\-input\\-from\\-string|with\\-output\\-to\\-string|decode\\-universal\\-time|encode\\-universal\\-time|internal\\-time\\-seconds|make\\-broadcast\\-stream|pprint\\-list\\-exhausted|user\\-homedir\\-pathname|integer\\-decode\\-float|make\\-two\\-way\\-stream|ascii\\-downcase\\-char|ascii\\-downcase\\-code|directory\\-namestring|pathname\\-absolute\\-p|read\\-char\\-no\\-hang|read\\-delimited\\-list|string\\-fold\\-compare|get\\-universal\\-time|open\\-binary\\-output|ascii\\-upcase\\-char|command\\-line\\-args|make\\-random\\-state|open\\-binary\\-input|pathname\\-directory|random\\-state\\-copy|random\\-state\\-next|seq\\-position\\-core|write\\-file\\-string|write\\-sequence|ascii\\-alpha\\-code|ascii\\-digit\\-code|delete\\-duplicates|enough\\-namestring|get\\-decoded\\-time|make\\-echo\\-stream|make\\-peek\\-stream|read\\-file\\-string|read\\-from\\-string|remove\\-duplicates|set\\-exclusive\\-or|try\\-bignum\\-\\>int|direction\\-append|direction\\-output|file\\-write\\-date|parse\\-namestring|position\\-if\\-not|prin1\\-to\\-string|princ\\-to\\-string|read\\-file\\-lines|row\\-major\\-index|try\\-float\\-\\>f32|try\\-float\\-\\>f64|write\\-to\\-string|direction\\-input|file\\-namestring|float\\-precision|merge\\-pathnames|random\\-state\\-p|ratio\\-expt\\-int|seq\\-count\\-core|sexpr\\-sym\\-name|string\\-\\>symbol|symbol\\-\\>string|try\\-int\\-\\>char|with\\-open\\-file|at\\-line\\-start|bignum\\-\\>float|bignum\\-\\>ratio|delete\\-if\\-not|describe\\-error|float\\-\\>bignum|home\\-directory|integer\\-length|member\\-if\\-not|nsubstitute\\-if|open\\-stream\\-p|pprint\\-newline|ratio\\-\\>bignum|read\\-sequence|read\\-datum\\-at|remove\\-if\\-not|row\\-major\\-get|row\\-major\\-set|seq\\-edit\\-core|seq\\-find\\-core|seq\\-in\\-bounds|seq\\-sort\\-core|set\\-difference|try\\-int\\-\\>i16|try\\-int\\-\\>i32|try\\-int\\-\\>u16|try\\-int\\-\\>u32|as\\-dyn\\-error|byte\\-position|char\\-\\>string|count\\-if\\-not|deposit\\-field|finish\\-output|float\\-\\>ratio|greater\\-equal|macroexpand\\-1|make\\-pathname|pathname\\-name|pathname\\-type|pprint\\-indent|ratio\\-\\>float|seq\\-any\\-core|seq\\-dedup\\-core|seq\\-window\\-start|seq\\-window\\-end|string\\-window\\-equal|software\\-type|substitute\\-if|sxhash\\-string|try\\-int\\-\\>i8|try\\-int\\-\\>u8|yes\\-or\\-no\\-p|alphanumericp|bignum\\-\\>int|char\\-in\\-bag|compile\\-file|decode\\-float|digit\\-\\>char|digit\\-weight|fill\\-pointer|find\\-if\\-not|float\\-digits|int\\-\\>bignum|machine\\-type|machine\\-instance|machine\\-version|software\\-version|short\\-site\\-name|long\\-site\\-name|file\\-author|not\\-greaterp|print\\-object|set\\-contents|sexpr\\-append|simple\\-error|truncate\\-div|write\\-string|ceiling\\-div|char\\-\\>name|copy\\-stream|delete\\-file|directory\\-p|float\\-\\>f32|float\\-\\>f64|float\\-\\>int|float\\-radix|int\\-\\>float|int\\-\\>ratio|intersection|lower\\-casep|name\\-\\>char|open\\-binary|open\\-output|parse\\-float|push\\-extend|rename\\-file|scale\\-float|sexpr\\-consp|to\\-pathname|unread\\-char|upper\\-casep|write\\-lines|both\\-casep|char\\-\\>int|denominator|float\\-sign|fresh\\-line|int\\-\\>char|less\\-equal|macroexpand|mask\\-field|not\\-equals|nsubstitute|open\\-input|pprint\\-pop|pprint\\-tab|probe\\-file|rationalize|read\\-lines|read\\-sexpr|right\\-trim|seq\\-equals|sexpr\\-atom|sexpr\\-bool|sexpr\\-char|sexpr\\-cons|sexpr\\-null|sexpr\\-symp|total\\-size|wrap\\-error|write\\-byte|write\\-char|write\\-item|write\\-line|y\\-or\\-n\\-p|bit\\-andc1|bit\\-andc2|byte\\-size|capitalize|complement|delete\\-if|dimensions|floor\\-div|in\\-bounds|int\\-\\>i16|int\\-\\>i32|int\\-\\>u16|int\\-\\>u32|left\\-trim|member\\-if|namestring|not\\-lessp|open\\-file|parse\\-int|peek\\-char|rassoc\\-if|read\\-byte|read\\-char|read\\-item|read\\-line|remove\\-if|round\\-div|seq\\-limit|sexpr\\-car|sexpr\\-cdr|sexpr\\-f32|sexpr\\-f64|sexpr\\-i16|sexpr\\-i32|sexpr\\-u16|sexpr\\-u32|sexpr\\-i8|sexpr\\-u8|sexpr\\-map|sexpr\\-str|substitute|unwrap\\-or|assoc\\-if|bit\\-nand|bit\\-orc1|bit\\-orc2|conjugate|copy\\-seq|count\\-if|dimension|directory|ftruncate|int\\-\\>i8|int\\-\\>u8|ldb\\-test|map\\-into|numerator|read\\-all|remainder|revappend|seq\\-flag|set\\-sbit|standardp|substring|bit\\-and|bit\\-eqv|bit\\-ior|bit\\-nor|bit\\-not|shift|bit\\-xor|downcase|fceiling|find\\-if|graphicp|greaterp|identity|imagpart|is\\-none|is\\-some|keywordp|logandc1|logandc2|logcount|mismatch|nbutlast|notevery|nreverse|position|realpart|set\\-bit|truename|truncate|bit\\-or|butlast|ceiling|complex|compose|entries|greater|is\\-err|logbitp|lognand|logorc1|logorc2|logtest|maphash|maplist|message|nreconc|pairlis|pushnew|replace|reverse|seventh|subsetp|adjoin|adjust|alphap|append|assert|caaaar|caaadr|caadar|caaddr|cadaar|cadadr|caddar|cadddr|cdaaar|cdaadr|cdadar|cdaddr|cddaar|cddadr|cdddar|cddddr|delete|digitp|eighth|equalp|equals|ffloor|filled|filter|fourth|fround|gensym|getenv|is\\-ok|length|listen|logand|logeqv|logior|lognor|lognot|logxor|mapcan|member|minusp|notany|random|rassoc|remove|rplaca|rplacd|search|second|signum|source|subseq|sxhash|terpri|unwrap|upcase|values|acons|acosh|asinh|assoc|atan2|atanh|boole|caaar|caadr|cadar|caddr|cdaar|cdadr|cddar|cdddr|clear|close|const|count|equal|evenp|every|fifth|first|floor|foldl|foldr|isqrt|ldiff|lessp|merge|nconc|ninth|phase|plusp|prin1|princ|round|sixth|split|tailp|tenth|third|union|write|zerop|sleep|acos|aref|asin|atan|byte|caar|cadr|cdar|cddr|cons|cosh|dlet|dump|eval|exit|expt|fill|find|flip|iter|keys|last|less|make|map2|mapc|next|oddp|push|rank|read|rest|sbit|sinh|size|sort|sqrt|take|tanh|time|trim|warn|abs|add|any|ash|bit|car|cdr|cis|cos|div|dpb|elt|eql|exp|gcd|get|lcm|ldb|len|log|map|max|min|mod|mul|new|not|nth|pop|ref|rem|set|sin|sub|tan|eq|lt)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "support.function.typelisp"
    },
    "builtin-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])(?:string\\-output\\-stream|string\\-input\\-stream|binary\\-file\\-stream|concatenated\\-stream|broadcast\\-stream|standard\\-stream|two\\-way\\-stream|ParseFloatError|hashtable\\-iter|universal\\-time|internal\\-time|ParseIntError|decoded\\-time|random\\-state|WrappedError|echo\\-stream|outputstream|peek\\-stream|vector\\-iter|ReadOutcome|SimpleError|array\\-iter|inputstream|byteoutput|charoutput|cons\\-cell|BitVector|EvalError|HashTable|ReadError|byteinput|charinput|fileerror|peekinput|pathname|complex|pathish|Number|Option|Result|Vector|bignum|stream|string|symbol|Array|Error|Sexpr|ratio|Bits|Iter|Self|bool|char|hash|Add|Div|Mul|Ord|Rem|Sub|f32|f64|i16|i32|u16|u32|Eq|i8|u8)(?![-A-Za-z0-9_?!*/+.%&^~:])",
      "name": "support.type.typelisp"
    },
    "never-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])!(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "support.type.never.typelisp"
    },
    "user-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])[A-Z][A-Za-z0-9_]*",
      "name": "entity.name.type.typelisp"
    },
    "constant": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:least\\-negative\\-normalized\\-double\\-float|least\\-positive\\-normalized\\-double\\-float|double\\-float\\-negative\\-epsilon|least\\-negative\\-double\\-float|least\\-positive\\-double\\-float|most\\-negative\\-double\\-float|most\\-positive\\-double\\-float|double\\-float\\-epsilon|most\\-negative\\-fixnum|most\\-positive\\-fixnum|boole\\-andc1|boole\\-andc2|boole\\-nand|boole\\-orc1|boole\\-orc2|boole\\-and|boole\\-clr|boole\\-eqv|boole\\-ior|boole\\-nor|boole\\-set|boole\\-xor|boole\\-c1|boole\\-c2|boole\\-1|boole\\-2|false|true|pi)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "constant.language.typelisp"
    },
    "number": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])[-+]?(?:0[xX][0-9a-fA-F]+|[0-9]+/[0-9]+|[0-9]+\\.[0-9]+(?:[eE][-+]?[0-9]+)?|[0-9]+[eE][-+]?[0-9]+|[0-9]+)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "constant.numeric.typelisp"
    },
    "global-variable": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])\\*[A-Za-z0-9?!*<>=/+-]+\\*(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "variable.other.global.typelisp"
    }
  }
}
