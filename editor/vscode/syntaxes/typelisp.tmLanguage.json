{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "typelisp",
  "scopeName": "source.typelisp",
  "patterns": [
    {
      "include": "#char-literal"
    },
    {
      "include": "#comment-block"
    },
    {
      "include": "#comment-line"
    },
    {
      "include": "#string"
    },
    {
      "include": "#dyn-type"
    },
    {
      "include": "#keyword-symbol"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#variable-definition"
    },
    {
      "include": "#impl"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#lambda-list"
    },
    {
      "include": "#special-form"
    },
    {
      "include": "#clause"
    },
    {
      "include": "#builtin-function"
    },
    {
      "include": "#builtin-type"
    },
    {
      "include": "#never-type"
    },
    {
      "include": "#user-type"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#number"
    },
    {
      "include": "#global-variable"
    }
  ],
  "repository": {
    "char-literal": {
      "match": "#\\\\(?:[A-Za-z][A-Za-z0-9]*|.)",
      "name": "constant.character.typelisp"
    },
    "comment-block": {
      "name": "comment.block.typelisp",
      "begin": "#\\|",
      "end": "\\|#",
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "comment-line": {
      "name": "comment.line.semicolon.typelisp",
      "begin": ";",
      "end": "$"
    },
    "string": {
      "name": "string.quoted.double.typelisp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\[ntr0\\\\\"]",
          "name": "constant.character.escape.typelisp"
        },
        {
          "match": "~(?:'.|[-+0-9,vV#:@])*(?:[\\]\\[a-zA-Z%&|~$_^<>{}();*?]|\\n)",
          "name": "constant.other.placeholder.typelisp"
        }
      ]
    },
    "dyn-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])(:dyn)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:\\s+([A-Za-z][A-Za-z0-9_-]*))?",
      "captures": {
        "1": {
          "name": "keyword.other.dyn.typelisp"
        },
        "2": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "keyword-symbol": {
      "match": "(?<![-A-Za-z0-9_:]):[A-Za-z][A-Za-z0-9_?!*<>=/+-]*",
      "name": "constant.other.symbol.typelisp"
    },
    "definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defmethod|defmacro|defun)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.function.typelisp"
        },
        "3": {
          "name": "entity.name.function.typelisp"
        }
      }
    },
    "type-definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defstruct|deftrait|defenum)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.class.typelisp"
        },
        "3": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "variable-definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defconstant|defvar)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.typelisp"
        },
        "3": {
          "name": "variable.other.definition.typelisp"
        }
      }
    },
    "impl": {
      "match": "\\(\\s*(impl(?:<[^>]*>)?)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?(?:\\s+([-A-Za-z0-9_?!*/+.%&^~:<>=]+))?",
      "captures": {
        "1": {
          "name": "keyword.control.impl.typelisp"
        },
        "2": {
          "name": "entity.name.type.typelisp"
        },
        "3": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "declaration": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:module|where|impl|load|pub|use)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.declaration.typelisp"
    },
    "lambda-list": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:\\&optional|\\&rest|\\&key)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "storage.modifier.lambda-list.typelisp"
    },
    "special-form": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:pprint\\-logical\\-block|make\\-synonym\\-stream|unquote\\-splicing|pprint\\-tabular|pprint\\-linear|documentation|pprint\\-fill|unreachable|quasiquote|while\\-let|compile|dotimes|if\\-let|println|rotatef|try\\-as|unquote|doiter|dolist|format|labels|lambda|pprint|return|shiftf|unless|apply|break|let\\*|match|panic|print|progn|quote|until|while|case|cond|decf|incf|list|loop|setf|todo|when|and|let|the|as|do|if|or)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.typelisp"
    },
    "clause": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:else)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.conditional.typelisp"
    },
    "builtin-function": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:internal\\-time\\-units\\-per\\-second|pprint\\-exit\\-if\\-list\\-exhausted|make\\-string\\-output\\-stream|peek\\-char\\-skip\\-whitespace|get\\-output\\-stream\\-string|make\\-string\\-input\\-stream|ensure\\-directories\\-exist|make\\-concatenated\\-stream|make\\-random\\-state\\-fresh|get\\-internal\\-real\\-time|with\\-input\\-from\\-string|standard\\-output\\-stream|with\\-output\\-to\\-string|make\\-broadcast\\-stream|pprint\\-list\\-exhausted|standard\\-input\\-stream|make\\-two\\-way\\-stream|directory\\-namestring|error\\-output\\-stream|stream\\-element\\-type|get\\-universal\\-time|read\\-char\\-no\\-hang|make\\-random\\-state|pathname\\-directory|random\\-state\\-copy|random\\-state\\-next|write\\-file\\-string|current\\-directory|enough\\-namestring|file\\-directory\\-p|make\\-echo\\-stream|pathname\\-match\\-p|read\\-file\\-string|stream\\-namestring|try\\-bignum\\-\\>int|with\\-open\\-stream|file\\-write\\-date|output\\-stream\\-p|parse\\-namestring|pathname\\-version|peek\\-char\\-until|read\\-file\\-lines|wild\\-pathname\\-p|file\\-namestring|input\\-stream\\-p|merge\\-pathnames|pathname\\-device|random\\-state\\-p|ratio\\-expt\\-int|sexpr\\-sym\\-name|string\\-\\>symbol|symbol\\-\\>string|try\\-int\\-\\>char|with\\-open\\-file|bignum\\-\\>float|bignum\\-\\>ratio|float\\-\\>bignum|integer\\-length|open\\-stream\\-p|pprint\\-newline|ratio\\-\\>bignum|write\\-sequence|as\\-dyn\\-error|byte\\-position|char\\-\\>string|deposit\\-field|finish\\-output|float\\-\\>ratio|greater\\-equal|make\\-pathname|pathname\\-host|pathname\\-name|pathname\\-type|pprint\\-indent|ratio\\-\\>float|read\\-sequence|yes\\-or\\-no\\-p|bignum\\-\\>int|clear\\-output|compile\\-file|force\\-output|int\\-\\>bignum|print\\-object|sexpr\\-append|truncate\\-div|write\\-string|ceiling\\-div|clear\\-input|delete\\-file|file\\-author|file\\-length|float\\-\\>int|int\\-\\>float|int\\-\\>ratio|parse\\-float|read\\-string|rename\\-file|sexpr\\-consp|sexpr\\-float|unread\\-char|char\\-\\>int|denominator|fresh\\-line|int\\-\\>char|less\\-equal|mask\\-field|not\\-equals|pprint\\-pop|pprint\\-tab|probe\\-file|sexpr\\-atom|sexpr\\-bool|sexpr\\-char|sexpr\\-cons|sexpr\\-null|sexpr\\-symp|write\\-char|write\\-line|y\\-or\\-n\\-p|byte\\-size|floor\\-div|namestring|parse\\-int|peek\\-char|read\\-char|read\\-line|remove\\-if|round\\-div|sexpr\\-car|sexpr\\-cdr|sexpr\\-int|sexpr\\-map|sexpr\\-str|unwrap\\-or|count\\-if|directory|ldb\\-test|numerator|substring|downcase|find\\-if|identity|is\\-none|is\\-some|keywordp|logandc1|logandc2|logcount|pathname|position|truename|truncate|butlast|ceiling|compose|entries|greater|is\\-err|logbitp|lognand|logorc1|logorc2|logtest|message|reverse|streamp|alphap|append|digitp|equalp|equals|filter|gensym|is\\-ok|length|listen|logand|logeqv|logior|lognor|lognot|logxor|member|minusp|random|remove|signum|source|subseq|terpri|unwrap|upcase|values|acosh|asinh|assoc|atanh|boole|clear|close|const|count|equal|evenp|every|floor|foldl|foldr|plusp|round|zerop|acos|asin|atan|byte|cons|cosh|eval|exit|expt|find|flip|iter|keys|last|less|next|oddp|open|push|read|sinh|sort|sqrt|take|tanh|time|abs|any|ash|car|cdr|cos|dpb|elt|eql|exp|gcd|get|lcm|ldb|len|log|map|max|min|mod|new|not|nth|pop|ref|rem|set|sin|tan|eq|lt)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "support.function.typelisp"
    },
    "builtin-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])(?:ParseFloatError|hashtable\\-iter|ParseIntError|random\\-state|vector\\-iter|cons\\-cell|EvalError|FileError|HashTable|ReadError|pathname|Option|Result|Vector|bignum|stream|string|symbol|Error|Sexpr|isize|ratio|usize|Iter|Self|bool|char|Ord|f32|f64|i16|i32|i64|u16|u32|u64|Eq|i8|u8)(?![-A-Za-z0-9_?!*/+.%&^~:])",
      "name": "support.type.typelisp"
    },
    "never-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])!(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "support.type.never.typelisp"
    },
    "user-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])[A-Z][A-Za-z0-9_]*",
      "name": "entity.name.type.typelisp"
    },
    "constant": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:boole\\-andc1|boole\\-andc2|boole\\-nand|boole\\-orc1|boole\\-orc2|boole\\-and|boole\\-clr|boole\\-eqv|boole\\-ior|boole\\-nor|boole\\-set|boole\\-xor|boole\\-c1|boole\\-c2|boole\\-1|boole\\-2|false|pi|true)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "constant.language.typelisp"
    },
    "number": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])[-+]?(?:0[xX][0-9a-fA-F]+|[0-9]+/[0-9]+|[0-9]+\\.[0-9]+(?:[eE][-+]?[0-9]+)?|[0-9]+[eE][-+]?[0-9]+|[0-9]+)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "constant.numeric.typelisp"
    },
    "global-variable": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])\\*[A-Za-z0-9?!*<>=/+-]+\\*(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "variable.other.global.typelisp"
    }
  }
}
