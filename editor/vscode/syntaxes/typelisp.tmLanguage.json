{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "typelisp",
  "scopeName": "source.typelisp",
  "patterns": [
    {
      "include": "#char-literal"
    },
    {
      "include": "#comment-block"
    },
    {
      "include": "#comment-line"
    },
    {
      "include": "#string"
    },
    {
      "include": "#dyn-type"
    },
    {
      "include": "#keyword-symbol"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#variable-definition"
    },
    {
      "include": "#impl"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#lambda-list"
    },
    {
      "include": "#special-form"
    },
    {
      "include": "#clause"
    },
    {
      "include": "#builtin-function"
    },
    {
      "include": "#builtin-type"
    },
    {
      "include": "#never-type"
    },
    {
      "include": "#user-type"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#number"
    },
    {
      "include": "#global-variable"
    }
  ],
  "repository": {
    "char-literal": {
      "match": "#\\\\(?:[A-Za-z][A-Za-z0-9]*|.)",
      "name": "constant.character.typelisp"
    },
    "comment-block": {
      "name": "comment.block.typelisp",
      "begin": "#\\|",
      "end": "\\|#",
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "comment-line": {
      "name": "comment.line.semicolon.typelisp",
      "begin": ";",
      "end": "$"
    },
    "string": {
      "name": "string.quoted.double.typelisp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\[ntr0\\\\\"]",
          "name": "constant.character.escape.typelisp"
        },
        {
          "match": "~(?:'.|[-+0-9,vV#:@])*(?:[\\]\\[a-zA-Z%&|~$_^<>{}();*?]|\\n)",
          "name": "constant.other.placeholder.typelisp"
        }
      ]
    },
    "dyn-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])(:dyn)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:\\s+([A-Za-z][A-Za-z0-9_-]*))?",
      "captures": {
        "1": {
          "name": "keyword.other.dyn.typelisp"
        },
        "2": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "keyword-symbol": {
      "match": "(?<![-A-Za-z0-9_:]):[A-Za-z][A-Za-z0-9_?!*<>=/+-]*",
      "name": "constant.other.symbol.typelisp"
    },
    "definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defsignature|defmethod|defmacro|defffi|defun)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.function.typelisp"
        },
        "3": {
          "name": "entity.name.function.typelisp"
        }
      }
    },
    "type-definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defstruct|def\\-c\\-struct|deftrait|defenum|deftype)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.class.typelisp"
        },
        "3": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "variable-definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defparameter|defconstant|defvar)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.typelisp"
        },
        "3": {
          "name": "variable.other.definition.typelisp"
        }
      }
    },
    "impl": {
      "match": "\\(\\s*(impl(?:<[^>]*>)?)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?(?:\\s+([-A-Za-z0-9_?!*/+.%&^~:<>=]+))?",
      "captures": {
        "1": {
          "name": "keyword.control.impl.typelisp"
        },
        "2": {
          "name": "entity.name.type.typelisp"
        },
        "3": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "declaration": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:shadowing\\-import|in\\-module|module|import|where|impl|load|pub|use)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.declaration.typelisp"
    },
    "lambda-list": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:\\&optional|\\&rest|\\&key)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "storage.modifier.lambda-list.typelisp"
    },
    "special-form": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:pprint\\-logical\\-block|unquote\\-splicing|symbol\\-macrolet|pprint\\-tabular|unwind\\-protect|documentation|pprint\\-linear|disassemble|pprint\\-fill|c\\-deref|c\\-alloc|return\\-from|source\\-file|unreachable|quasiquote|while\\-let|macrolet|compile|dotimes|println|rotatef|unquote|untrace|doiter|dolist|format|if\\-let|labels|lambda|pprint|return|select|shiftf|thread|try\\-as|tuple|unless|unsafe|apply|block|break|catch|ccase|ecase|match|panic|print|prog1|prog2|progn|psetf|psetq|quote|throw|trace|until|while|case|cond|decf|incf|let*|list|loop|c\\-ref|setf|setq|step|task|todo|when|and|do*|let|the|as|do|ed|if|or)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.typelisp"
    },
    "clause": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:else)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.conditional.typelisp"
    },
    "builtin-function": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:read\\-from\\-string\\-preserving\\-whitespace|read\\-sexpr\\-preserving\\-whitespace|internal\\-time\\-units\\-per\\-second|pprint\\-exit\\-if\\-list\\-exhausted|get\\-dispatch\\-macro\\-character|set\\-dispatch\\-macro\\-character|lisp\\-implementation\\-version|make\\-string\\-output\\-stream|ensure\\-directories\\-exist|get\\-output\\-stream\\-string|lisp\\-implementation\\-type|make\\-concatenated\\-stream|make\\-string\\-input\\-stream|timezone\\-offset\\-seconds|with\\-standard\\-io\\-syntax|get\\-internal\\-real\\-time|with\\-input\\-from\\-string|decode\\-universal\\-time|encode\\-universal\\-time|get\\-internal\\-run\\-time|internal\\-time\\-seconds|make\\-broadcast\\-stream|pprint\\-list\\-exhausted|requested\\-server\\-name|user\\-homedir\\-pathname|with\\-output\\-to\\-string|available\\-parallelism|directory\\-namestring|integer\\-decode\\-float|set\\-keepalive\\-period|get\\-macro\\-character|make\\-two\\-way\\-stream|pathname\\-absolute\\-p|read\\-delimited\\-list|set\\-macro\\-character|timezone\\-daylight\\-p|tls\\-add\\-certificate|destructuring\\-bind|get\\-universal\\-time|open\\-binary\\-output|pathname\\-directory|command\\-line\\-args|delete\\-duplicates|enough\\-namestring|make\\-random\\-state|open\\-binary\\-input|read\\-char\\-no\\-hang|remove\\-duplicates|seed\\-random\\-state|write\\-file\\-string|direction\\-append|direction\\-output|get\\-decoded\\-time|machine\\-instance|make\\-echo\\-stream|make\\-peek\\-stream|parse\\-namestring|read\\-file\\-string|read\\-from\\-string|set\\-exclusive\\-or|software\\-version|direction\\-input|file\\-namestring|file\\-write\\-date|float\\-precision|machine\\-version|merge\\-pathnames|position\\-if\\-not|prin1\\-to\\-string|princ\\-to\\-string|read\\-file\\-lines|row\\-major\\-index|short\\-site\\-name|try\\-int\\-\\>c\\-ulong|shutdown\\-output|try\\-int\\-\\>c\\-long|with\\-connection|write\\-to\\-string|byte\\-stream\\-of|char\\-stream\\-of|unwrap\\-or\\-else|describe\\-error|home\\-directory|integer\\-length|long\\-site\\-name|nsubstitute\\-if|pprint\\-newline|random\\-state\\-p|set\\-difference|sexpr\\-sym\\-name|string\\-\\>symbol|symbol\\-\\>string|try\\-float\\-\\>f32|try\\-float\\-\\>f64|with\\-open\\-file|write\\-sequence|alphanumericp|at\\-line\\-start|byte\\-position|delete\\-if\\-not|deposit\\-field|finish\\-output|greater\\-equal|local\\-address|macroexpand\\-1|make\\-pathname|member\\-if\\-not|open\\-stream\\-p|pathname\\-name|pathname\\-type|pprint\\-indent|read\\-sequence|remove\\-if\\-not|row\\-major\\-get|row\\-major\\-set|set\\-keepalive|software\\-type|substitute\\-if|sxhash\\-string|try\\-int\\-\\>char|wait\\-readable|wait\\-writable|as\\-dyn\\-error|char\\-\\>string|compile\\-file|count\\-if\\-not|decode\\-float|digit\\-weight|fill\\-pointer|float\\-\\>ratio|float\\-digits|current\\-id|concatenate|intersection|machine\\-type|not\\-greaterp|peer\\-address|peer\\-subject|print\\-object|ratio\\-\\>float|socket\\-error|string\\-\\>utf8|unix\\-connect|utf8\\-\\>string|set\\-nodelay|tcp\\-connect|tls\\-connect|unix\\-listen|ratio\\-\\>int|set\\-contents|sexpr\\-append|simple\\-error|truncate\\-div|try\\-int\\-\\>i16|try\\-int\\-\\>i32|try\\-int\\-\\>u16|try\\-int\\-\\>u32|write\\-string|ceiling\\-div|copy\\-stream|delete\\-file|denominator|digit\\-\\>char|directory\\-p|file\\-author|find\\-if\\-not|float\\-radix|int\\-\\>c\\-ulong|int\\-\\>c\\-long|lower\\-casep|macroexpand|nsubstitute|open\\-binary|open\\-output|parse\\-float|push\\-extend|rationalize|rename\\-file|scale\\-float|sexpr\\-consp|to\\-pathname|try\\-int\\-\\>i8|try\\-int\\-\\>u8|unread\\-char|upper\\-casep|write\\-lines|yes\\-or\\-no\\-p|both\\-casep|take\\-while|capitalize|char\\-\\>name|complement|dimensions|float\\-\\>f32|float\\-\\>f64|float\\-\\>int|float\\-sign|fresh\\-line|int\\-\\>float|int\\-\\>ratio|less\\-equal|mask\\-field|name\\-\\>char|namestring|not\\-equals|open\\-input|pprint\\-pop|pprint\\-tab|probe\\-file|read\\-lines|read\\-sexpr|right\\-trim|seq\\-equals|sexpr\\-atom|sexpr\\-bool|sexpr\\-char|sexpr\\-cons|sexpr\\-null|sexpr\\-symp|substitute|tcp\\-listen|tls\\-listen|total\\-size|wrap\\-error|write\\-byte|write\\-char|write\\-item|write\\-line|bit\\-andc1|bit\\-andc2|byte\\-size|char\\-\\>int|conjugate|delete\\-if|dimension|directory|floor\\-div|ftruncate|heap\\-info|in\\-bounds|int\\-\\>char|left\\-trim|member\\-if|not\\-lessp|numerator|open\\-file|parse\\-int|peek\\-char|rassoc\\-if|read\\-byte|read\\-char|read\\-item|read\\-line|recv\\-from|remainder|remove\\-if|revappend|round\\-div|sexpr\\-car|sexpr\\-cdr|sexpr\\-f32|sexpr\\-f64|sexpr\\-i16|sexpr\\-int|sexpr\\-i32|sexpr\\-map|sexpr\\-str|sexpr\\-u16|sexpr\\-u32|standardp|substring|unwrap\\-or|with\\-lock|assoc\\-if|bit\\-nand|bit\\-orc1|bit\\-orc2|copy\\-seq|count\\-if|and\\-then|enumerate|flat\\-map|downcase|fceiling|graphicp|greaterp|identity|imagpart|int\\-\\>i16|int\\-\\>i32|int\\-\\>int|int\\-\\>u16|int\\-\\>u32|keywordp|ldb\\-test|logandc1|logandc2|logcount|map\\-into|mismatch|nbutlast|notevery|nreverse|position|read\\-all|realpart|set\\-sbit|sexpr\\-i8|sexpr\\-u8|truename|truncate|udp\\-bind|y\\-or\\-n\\-p|bit\\-and|bit\\-eqv|bit\\-ior|bit\\-nor|bit\\-not|bit\\-xor|map\\-err|or\\-else|butlast|ceiling|complex|compose|dribble|entries|find\\-if|greater|int\\-\\>i8|int\\-\\>u8|is\\-none|is\\-some|logbitp|lognand|logorc1|logorc2|logtest|maphash|maplist|message|nreconc|pairlis|pushnew|replace|reverse|send\\-to|set\\-bit|seventh|subsetp|collect|iterate|accept|adjoin|adjust|alphap|append|assert|bit\\-or|caaaar|caaadr|caadar|caaddr|cadaar|cadadr|caddar|cadddr|cdaaar|cdaadr|cdadar|cdaddr|cddaar|cddadr|cdddar|cddddr|delete|digitp|eighth|equalp|equals|ffloor|filled|filter|fourth|fround|gensym|getenv|is\\-err|length|listen|logand|logeqv|logior|lognor|lognot|logxor|mapcon|mapcan|member|minusp|notany|random|rassoc|remove|rplaca|rplacd|search|second|signum|source|subseq|sxhash|terpri|unlock|unwrap|upcase|values|expect|ok\\-or|repeat|acons|acosh|after|asinh|assoc|atan2|atanh|boole|caaar|caadr|cadar|caddr|cdaar|cdadr|cddar|cdddr|clear|close|const|count|equal|evenp|every|fifth|first|floor|foldl|foldr|is\\-ok|isqrt|ldiff|lessp|merge|nconc|ninth|phase|plusp|prin1|princ|round|shift|sixth|sleep|spawn|split|tailp|tenth|third|union|write|zerop|yield|chain|acos|aref|asin|atan|byte|caar|cadr|cdar|cddr|chan|cons|cosh|dlet|done|dump|eval|exit|expt|fill|find|flip|iter|join|keys|last|less|lock|make|map2|mapl|mapc|next|oddp|push|rank|read|recv|rest|room|sbit|send|sinh|size|sort|sqrt|take|tanh|time|trim|wait|warn|skip|abs|add|any|ash|bit|cap|car|cdr|cis|cos|div|dpb|elt|eql|exp|gcd|get|lcm|ldb|len|log|map|max|min|mod|mul|new|not|nth|pop|ref|rem|set|sin|sub|tan|zip|eq|lt)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "support.function.typelisp"
    },
    "builtin-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])(?:string\\-output\\-stream|string\\-input\\-stream|binary\\-file\\-stream|take\\-while\\-iter|enumerate\\-iter|flat\\-map\\-iter|iterate\\-iter|file\\-stream|concatenated\\-stream|socket\\-byte\\-stream|broadcast\\-stream|socket\\-listener|standard\\-stream|two\\-way\\-stream|ParseFloatError|hashtable\\-iter|universal\\-time|internal\\-time|ParseIntError|socket\\-stream|decoded\\-time|random\\-state|WrappedError|echo\\-stream|outputstream|peek\\-stream|vector\\-iter|filter\\-iter|repeat\\-iter|ReadOutcome|SimpleError|array\\-iter|inputstream|chain\\-iter|byteoutput|charoutput|udp\\-socket|skip\\-iter|take\\-iter|WaitGroup|cons\\-cell|BitVector|EvalError|HashTable|ReadError|byteinput|charinput|fileerror|peekinput|map\\-iter|zip\\-iter|NetError|datagram|pathname|complex|pathish|c\\-ulong|c\\-long|Number|Option|Result|Thread|Vector|stream|string|symbol|Array|Error|Mutex|Sexpr|ratio|Bits|Iter|Chan|Self|Task|bool|char|hash|ptr|Add|Div|Mul|Ord|Rem|Sub|f32|f64|i16|i32|int|u16|u32|Eq|i8|u8)(?![-A-Za-z0-9_?!*/+.%&^~:])",
      "name": "support.type.typelisp"
    },
    "never-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])!(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "support.type.never.typelisp"
    },
    "user-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])[A-Z][A-Za-z0-9_]*",
      "name": "entity.name.type.typelisp"
    },
    "constant": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:least\\-negative\\-normalized\\-double\\-float|least\\-positive\\-normalized\\-double\\-float|double\\-float\\-negative\\-epsilon|least\\-negative\\-double\\-float|least\\-positive\\-double\\-float|most\\-negative\\-double\\-float|most\\-positive\\-double\\-float|double\\-float\\-epsilon|most\\-negative\\-fixnum|most\\-positive\\-fixnum|boole\\-andc1|boole\\-andc2|boole\\-nand|boole\\-orc1|boole\\-orc2|boole\\-and|boole\\-clr|boole\\-eqv|boole\\-ior|boole\\-nor|boole\\-set|boole\\-xor|boole\\-c1|boole\\-c2|boole\\-1|boole\\-2|false|true|pi)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "constant.language.typelisp"
    },
    "number": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])[-+]?(?:0[xX][0-9a-fA-F]+|[0-9]+/[0-9]+|[0-9]+\\.[0-9]+(?:[eE][-+]?[0-9]+)?|[0-9]+[eE][-+]?[0-9]+|[0-9]+)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "constant.numeric.typelisp"
    },
    "global-variable": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])\\*[A-Za-z0-9?!*<>=/+-]+\\*(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "variable.other.global.typelisp"
    }
  }
}
