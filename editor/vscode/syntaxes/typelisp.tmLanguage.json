{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "typelisp",
  "scopeName": "source.typelisp",
  "patterns": [
    {
      "include": "#char-literal"
    },
    {
      "include": "#comment-block"
    },
    {
      "include": "#comment-line"
    },
    {
      "include": "#string"
    },
    {
      "include": "#dyn-type"
    },
    {
      "include": "#keyword-symbol"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#type-definition"
    },
    {
      "include": "#variable-definition"
    },
    {
      "include": "#impl"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#lambda-list"
    },
    {
      "include": "#special-form"
    },
    {
      "include": "#clause"
    },
    {
      "include": "#builtin-function"
    },
    {
      "include": "#builtin-type"
    },
    {
      "include": "#never-type"
    },
    {
      "include": "#user-type"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#number"
    },
    {
      "include": "#global-variable"
    }
  ],
  "repository": {
    "char-literal": {
      "match": "#\\\\(?:[A-Za-z][A-Za-z0-9]*|.)",
      "name": "constant.character.typelisp"
    },
    "comment-block": {
      "name": "comment.block.typelisp",
      "begin": "#\\|",
      "end": "\\|#",
      "patterns": [
        {
          "include": "#comment-block"
        }
      ]
    },
    "comment-line": {
      "name": "comment.line.semicolon.typelisp",
      "begin": ";",
      "end": "$"
    },
    "string": {
      "name": "string.quoted.double.typelisp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\[ntr0\\\\\"]",
          "name": "constant.character.escape.typelisp"
        },
        {
          "match": "~(?:'.|[-+0-9,vV#:@])*(?:[\\]\\[a-zA-Z%&|~$_^<>{}();*?]|\\n)",
          "name": "constant.other.placeholder.typelisp"
        }
      ]
    },
    "dyn-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])(:dyn)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:\\s+([A-Za-z][A-Za-z0-9_-]*))?",
      "captures": {
        "1": {
          "name": "keyword.other.dyn.typelisp"
        },
        "2": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "keyword-symbol": {
      "match": "(?<![-A-Za-z0-9_:]):[A-Za-z][A-Za-z0-9_?!*<>=/+-]*",
      "name": "constant.other.symbol.typelisp"
    },
    "definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defmethod|defmacro|defun)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.function.typelisp"
        },
        "3": {
          "name": "entity.name.function.typelisp"
        }
      }
    },
    "type-definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defstruct|deftrait|defenum)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.class.typelisp"
        },
        "3": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "variable-definition": {
      "match": "\\(\\s*(?:(pub)\\s+)?(defconstant|defvar)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*\\(?\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?",
      "captures": {
        "1": {
          "name": "storage.modifier.typelisp"
        },
        "2": {
          "name": "storage.type.typelisp"
        },
        "3": {
          "name": "variable.other.definition.typelisp"
        }
      }
    },
    "impl": {
      "match": "\\(\\s*(impl(?:<[^>]*>)?)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])\\s*([-A-Za-z0-9_?!*/+.%&^~:<>=]+)?(?:\\s+([-A-Za-z0-9_?!*/+.%&^~:<>=]+))?",
      "captures": {
        "1": {
          "name": "keyword.control.impl.typelisp"
        },
        "2": {
          "name": "entity.name.type.typelisp"
        },
        "3": {
          "name": "entity.name.type.typelisp"
        }
      }
    },
    "declaration": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:module|where|impl|load|pub|use)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.declaration.typelisp"
    },
    "lambda-list": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:\\&optional|\\&rest|\\&key)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "storage.modifier.lambda-list.typelisp"
    },
    "special-form": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:pprint\\-logical\\-block|unquote\\-splicing|pprint\\-tabular|unwind\\-protect|documentation|pprint\\-linear|pprint\\-fill|unreachable|quasiquote|while\\-let|compile|dotimes|println|rotatef|unquote|doiter|dolist|format|if\\-let|labels|lambda|pprint|return|shiftf|try\\-as|unless|apply|break|catch|ccase|ecase|match|panic|print|prog1|prog2|progn|psetf|psetq|quote|throw|until|while|case|cond|decf|incf|let\\*|list|loop|setf|setq|todo|when|and|do\\*|let|the|as|do|if|or)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.typelisp"
    },
    "clause": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:else)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "keyword.control.conditional.typelisp"
    },
    "builtin-function": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:internal\\-time\\-units\\-per\\-second|pprint\\-exit\\-if\\-list\\-exhausted|lisp\\-implementation\\-version|make\\-string\\-output\\-stream|ensure\\-directories\\-exist|get\\-output\\-stream\\-string|lisp\\-implementation\\-type|make\\-concatenated\\-stream|make\\-string\\-input\\-stream|make\\-random\\-state\\-fresh|get\\-internal\\-real\\-time|with\\-input\\-from\\-string|decode\\-universal\\-time|encode\\-universal\\-time|make\\-broadcast\\-stream|pprint\\-list\\-exhausted|user\\-homedir\\-pathname|with\\-output\\-to\\-string|directory\\-namestring|integer\\-decode\\-float|ascii\\-downcase\\-char|ascii\\-downcase\\-code|make\\-two\\-way\\-stream|pathname\\-absolute\\-p|string\\-fold\\-compare|get\\-universal\\-time|pathname\\-directory|ascii\\-upcase\\-char|command\\-line\\-args|delete\\-duplicates|enough\\-namestring|make\\-random\\-state|random\\-state\\-copy|random\\-state\\-next|remove\\-duplicates|write\\-file\\-string|ascii\\-alpha\\-code|ascii\\-digit\\-code|direction\\-append|direction\\-output|get\\-decoded\\-time|make\\-echo\\-stream|make\\-peek\\-stream|parse\\-namestring|read\\-file\\-string|set\\-exclusive\\-or|direction\\-input|file\\-namestring|file\\-write\\-date|float\\-precision|merge\\-pathnames|read\\-file\\-lines|try\\-bignum\\-\\>int|home\\-directory|integer\\-length|nsubstitute\\-if|pprint\\-newline|random\\-state\\-p|ratio\\-expt\\-int|set\\-difference|sexpr\\-sym\\-name|string\\-\\>symbol|symbol\\-\\>string|with\\-open\\-file|alphanumericp|at\\-line\\-start|bignum\\-\\>float|bignum\\-\\>ratio|byte\\-position|delete\\-if\\-not|deposit\\-field|finish\\-output|float\\-\\>bignum|greater\\-equal|make\\-pathname|member\\-if\\-not|open\\-stream\\-p|pathname\\-name|pathname\\-type|pprint\\-indent|ratio\\-\\>bignum|remove\\-if\\-not|software\\-type|substitute\\-if|try\\-int\\-\\>char|as\\-dyn\\-error|char\\-\\>string|compile\\-file|count\\-if\\-not|decode\\-float|digit\\-weight|float\\-\\>ratio|float\\-digits|intersection|machine\\-type|not\\-greaterp|print\\-object|ratio\\-\\>float|set\\-contents|sexpr\\-append|truncate\\-div|write\\-string|bignum\\-\\>int|ceiling\\-div|char\\-in\\-bag|copy\\-stream|delete\\-file|denominator|digit\\-\\>char|directory\\-p|find\\-if\\-not|float\\-radix|int\\-\\>bignum|lower\\-casep|nsubstitute|open\\-output|parse\\-float|rationalize|rename\\-file|scale\\-float|sexpr\\-consp|sexpr\\-float|to\\-pathname|unread\\-char|upper\\-casep|write\\-lines|yes\\-or\\-no\\-p|both\\-casep|capitalize|char\\-\\>name|float\\-\\>int|float\\-sign|fresh\\-line|int\\-\\>float|int\\-\\>ratio|less\\-equal|mask\\-field|name\\-\\>char|namestring|not\\-equals|open\\-input|pprint\\-pop|pprint\\-tab|probe\\-file|read\\-lines|read\\-sexpr|right\\-trim|seq\\-equals|sexpr\\-atom|sexpr\\-bool|sexpr\\-char|sexpr\\-cons|sexpr\\-null|sexpr\\-symp|substitute|write\\-char|write\\-item|write\\-line|byte\\-size|char\\-\\>int|conjugate|delete\\-if|directory|floor\\-div|ftruncate|int\\-\\>char|left\\-trim|member\\-if|not\\-lessp|numerator|open\\-file|parse\\-int|peek\\-char|rassoc\\-if|read\\-char|read\\-item|read\\-line|remainder|remove\\-if|revappend|round\\-div|sexpr\\-car|sexpr\\-cdr|sexpr\\-int|sexpr\\-map|sexpr\\-str|standardp|substring|unwrap\\-or|assoc\\-if|copy\\-seq|count\\-if|downcase|fceiling|graphicp|greaterp|identity|imagpart|keywordp|ldb\\-test|logandc1|logandc2|logcount|map\\-into|mismatch|nbutlast|notevery|nreverse|position|read\\-all|realpart|truename|truncate|y\\-or\\-n\\-p|bit\\-and|bit\\-not|bit\\-xor|butlast|ceiling|complex|compose|entries|find\\-if|greater|is\\-none|is\\-some|logbitp|lognand|logorc1|logorc2|logtest|maplist|message|nreconc|pairlis|pushnew|replace|reverse|seventh|subsetp|adjoin|alphap|append|bit\\-or|caaaar|caaadr|caadar|caaddr|cadaar|cadadr|caddar|cadddr|cdaaar|cdaadr|cdadar|cdaddr|cddaar|cddadr|cdddar|cddddr|delete|digitp|eighth|equalp|equals|ffloor|filled|filter|fourth|fround|gensym|getenv|is\\-err|length|logand|logeqv|logior|lognor|lognot|logxor|mapcan|member|minusp|notany|random|rassoc|remove|rplaca|rplacd|search|second|signum|source|subseq|terpri|unwrap|upcase|values|acons|acosh|asinh|assoc|atan2|atanh|boole|caaar|caadr|cadar|caddr|cdaar|cdadr|cddar|cdddr|clear|close|const|count|equal|evenp|every|fifth|first|floor|foldl|foldr|is\\-ok|isqrt|ldiff|lessp|merge|nconc|ninth|phase|plusp|round|sixth|split|tailp|tenth|third|union|zerop|acos|asin|atan|byte|caar|cadr|cdar|cddr|cons|cosh|dump|eval|exit|expt|fill|find|flip|iter|keys|last|less|map2|mapc|next|oddp|push|read|rest|sinh|sort|sqrt|take|tanh|time|trim|abs|add|any|ash|car|cdr|cis|cos|div|dpb|elt|eql|exp|gcd|get|lcm|ldb|len|log|map|max|min|mod|mul|new|not|nth|pop|ref|rem|set|sin|sub|tan|eq|lt)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "support.function.typelisp"
    },
    "builtin-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])(?:string\\-output\\-stream|concatenated\\-stream|string\\-input\\-stream|broadcast\\-stream|ParseFloatError|standard\\-stream|hashtable\\-iter|two\\-way\\-stream|ParseIntError|decoded\\-time|outputstream|random\\-state|echo\\-stream|inputstream|peek\\-stream|vector\\-iter|charoutput|EvalError|HashTable|ReadError|charinput|cons\\-cell|fileerror|peekinput|pathname|complex|pathish|Number|Option|Result|Vector|bignum|stream|string|symbol|Error|Sexpr|isize|ratio|usize|Bits|Iter|Self|bool|char|Add|Div|Mul|Ord|Rem|Sub|f32|f64|i16|i32|i64|u16|u32|u64|Eq|i8|u8)(?![-A-Za-z0-9_?!*/+.%&^~:])",
      "name": "support.type.typelisp"
    },
    "never-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])!(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "support.type.never.typelisp"
    },
    "user-type": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:>])[A-Z][A-Za-z0-9_]*",
      "name": "entity.name.type.typelisp"
    },
    "constant": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])(?:least\\-negative\\-normalized\\-double\\-float|least\\-positive\\-normalized\\-double\\-float|double\\-float\\-negative\\-epsilon|least\\-negative\\-double\\-float|least\\-positive\\-double\\-float|most\\-negative\\-double\\-float|most\\-positive\\-double\\-float|double\\-float\\-epsilon|most\\-negative\\-fixnum|most\\-positive\\-fixnum|boole\\-andc1|boole\\-andc2|boole\\-nand|boole\\-orc1|boole\\-orc2|boole\\-and|boole\\-clr|boole\\-eqv|boole\\-ior|boole\\-nor|boole\\-set|boole\\-xor|boole\\-c1|boole\\-c2|boole\\-1|boole\\-2|false|true|pi)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "constant.language.typelisp"
    },
    "number": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])[-+]?(?:0[xX][0-9a-fA-F]+|[0-9]+/[0-9]+|[0-9]+\\.[0-9]+(?:[eE][-+]?[0-9]+)?|[0-9]+[eE][-+]?[0-9]+|[0-9]+)(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "constant.numeric.typelisp"
    },
    "global-variable": {
      "match": "(?<![-A-Za-z0-9_?!*/+.%&^~:<>=])\\*[A-Za-z0-9?!*<>=/+-]+\\*(?![-A-Za-z0-9_?!*/+.%&^~:<>=])",
      "name": "variable.other.global.typelisp"
    }
  }
}
