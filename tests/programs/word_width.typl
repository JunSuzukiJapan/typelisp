;; What a 32-bit word has to get right: an `int` it holds as a bignum, a value
;; wider than it, a fixed-width integer a fixnum cannot hold.
(defstruct Wide (a i32) (b u32) (c f64))
(defun add3 ((x f64) (n i32) (y f64)) f64 (+ x (+ (int->float (as int n)) y)))
(defun deep ((n int) (x f64)) f64 (if (= n 0) x (+ 0.5 (deep (- n 1) x))))
(defun adder ((x f64) (u u32)) (fn (f64) f64) (lambda ((y f64)) f64 (+ x (+ y (int->float (as int u))))))
(defun show ((n int)) () (println "~a" n))
(defun main () int
  (show 1073741823) (show 1073741824) (show -1073741824) (show -1073741825)
  (show 2147483648) (show 4294967296) (show 9007199254740993)
  (show (+ 1073741823 1)) (show (- -1073741824 1)) (show (* 46341 46341)) (show (* 100000 100000))
  (show (- (+ 1073741823 1) 1)) (show (ash 1 40)) (show (logand 4294967295 305419896))
  (show (as int (as i32 2000000000))) (show (as int (as u32 4000000000))) (show (as int (as i32 -2147483648)))
  (println "~a" (add3 1.5 (as i32 -7) 2.25))
  (println "~a" (deep 10 0.25))
  (println "~a" ((adder 1.5 (as u32 4000000000)) 2.0))
  (let ((w (make-instance 'Wide :a (as i32 2000000000) :b (as u32 4000000000) :c 2.5)))
    (println "~a ~a ~a" (as int w::a) (as int w::b) w::c)
    (setf w::a (as i32 -2000000000))
    (show (as int w::a)))
  (let ((v (the Vector<i32> (Vector::new))))
    (push v (as i32 2000000000))
    (push v (as i32 -2000000000))
    (show (as int (get v 0)))
    (show (as int (get v 1))))
  (println "~s" '(1.5 2147483648 -1073741825 #\a "x" y))
  (show (catch 'out (throw 'out 5000000000)))
  (println "~a" (the f32 1.25))
  (show (gcd 4294967296 6442450944))
  (println "~a" (/ 4294967296 3))
  0)
