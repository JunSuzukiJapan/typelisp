#!/usr/bin/env bash
# Stops a push that CI's Translations job would reject. pre-commit lets the
# commit that changes a Japanese original through before its translations
# are brought up to date; this is where they must be.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! out="$(scripts/check-translations.sh 2>&1)"; then
    echo "pre-push: translations are out of date (CI / Translations fails on this):" >&2
    echo "$out" | grep -v '^all ' >&2
    exit 1
fi
