<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The JIT (`compile`, and the bundled standard library, which is
	     bitcode loaded through the JIT at startup) writes machine code into
	     memory and makes it executable. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- `defffi` loads whatever C library a program names (`:library`),
	     which is not signed by the same team as typl. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
