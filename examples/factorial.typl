;; 階乗。固定幅の整数ではすぐ桁あふれするので、正確な任意精度演算には bignum を使う。
(defun factorial ((n i32)) bignum
  (let ((acc (int->bignum 1)))
    (dotimes (i n)
      (setf acc (* acc (int->bignum (+ i 1)))))
    acc))

(dotimes (i 15)
  (let ((n (+ i 1)))
    (print "~d" n)
    (print "! = ")
    (println "~d" (factorial n))))
