;; Traits: Dog and Cat implement Animal, and speak comes from the trait's default
;; body. Values of both types share one Vector<:dyn Animal>.
;; トレイト: Dog と Cat が Animal を実装し、speak はトレイトの既定の本体を使う。
;; 2つの型の値を1つの Vector<:dyn Animal> に入れる。
(deftrait Animal ()
  (name (self) string)
  (sound (self) string)
  (speak (self) string
    (format false "~a says ~a" (name self) (sound self))))

(defstruct Dog (nick string))
(defstruct Cat (nick string))

(impl Animal Dog
  (name (self) string self::nick)
  (sound (self) string "Woof"))

(impl Animal Cat
  (name (self) string self::nick)
  (sound (self) string "Meow"))

(defun main () ()
  (let ((animals (the Vector<:dyn Animal> (Vector::new))))
    (push animals (make-instance 'Dog :nick "Pochi"))
    (push animals (make-instance 'Cat :nick "Tama"))
    (doiter (a (iter animals))
      (println "~a" (speak a)))))

(main)
