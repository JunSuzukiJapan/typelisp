;; Evaluation of the syntax tree (expr).
;; 構文木 (expr) の評価。
(use parser::expr)
;; `eval` is also a standard library function, so this module makes the name its own.
;; `eval` は標準ライブラリの関数の名前でもあるので、このモジュールの名前にする。
(shadow eval)

(pub defun eval ((e expr)) int
  (match e
    ((num v) v)
    ((add a b) (+ (eval a) (eval b)))
    ((sub a b) (- (eval a) (eval b)))
    ((mul a b) (* (eval a) (eval b)))
    ((div a b) (truncate (eval a) (eval b)))))
