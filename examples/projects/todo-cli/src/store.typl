;; ToDo の保存領域。HashTable<int,todo-item> で id 引き。
(use model::todo-item)
(use model::make-todo)

(defvar (store HashTable<int,todo-item>) (HashTable::new))
(defvar (next-id int) 1)

(pub defun add-todo ((text string)) int
  (let ((tid next-id))
    (set store tid (make-todo tid text false))
    (setf next-id (+ next-id 1))
    tid))

(pub defun complete-todo ((tid int)) bool
  (match (get store tid)
    ((some td) (setf td::done true) true)
    ((none) false)))

(pub defun remove-todo ((tid int)) bool
  (is-some (remove store tid)))

(pub defun all-ids () Vector<int>
  (sort (iter (keys store)) (lambda ((a int) (b int)) bool (< a b))))

(pub defun find-todo ((tid int)) Option<todo-item>
  (get store tid))
