;; The shapes. Everything involving `:dyn` is confined to this module.
;; Two things to look at -- (1) shapes of different concrete types are mixed in a
;; Vector<:dyn Shape>, and the single (paint s cv) in the drawing loop is dispatched
;; to each implementation. (2) Parse failures of different kinds are returned
;; gathered into one Result<T, :dyn Error>.
;; 図形たち。`:dyn` に関わるものは全部このモジュールに閉じている。
;; 見どころは2つ ── (1) 具象型の違う図形を Vector<:dyn Shape> に混ぜ、描画ループの
;; たった1つの (paint s cv) が実装ごとに振り分けられる。(2) パースの失敗は種類の
;; 違うエラーを Result<T, :dyn Error> の1本にまとめて返す。
(use canvas::canvas)
(use canvas::plot)

;; The common interface of shapes. paint promises only "draw yourself onto the
;; canvas"; which shapes exist is visible neither to callers nor to the canvas.
;; Every method has a self receiver and Self appears nowhere but the receiver, so
;; this trait can be made :dyn (object safety).
;; 図形の共通インタフェース。paint は「自分をキャンバスへ描く」だけを約束し、
;; どんな図形が存在するかは呼び出し側にもキャンバスにも見えない。
;; 全メソッドが self レシーバを持ち Self をレシーバ以外に書いていないので、
;; このトレイトは :dyn 化できる(object safety)。
(deftrait Shape ()
  (label ((self Self)) string)
  (paint ((self Self) (cv canvas)) ()))

(defstruct rect (x int) (y int) (w int) (h int))
(defstruct circle (cx int) (cy int) (r int))
(defstruct hline (x int) (y int) (len int))

(impl Shape rect
  (label ((self Self)) string "rect")
  (paint ((self Self) (cv canvas)) ()
    (dotimes (i self::w)
      (plot cv (+ self::x i) self::y #\-)
      (plot cv (+ self::x i) (+ self::y (- self::h 1)) #\-))
    (dotimes (j self::h)
      (plot cv self::x (+ self::y j) #\|)
      (plot cv (+ self::x (- self::w 1)) (+ self::y j) #\|))))

;; Character cells are tall, so vertical distance counts double to make it look round.
;; Only cells within r of r*r are plotted (i.e. just the outline).
;; 文字セルは縦長なので、縦方向の距離を2倍に数えて丸く見せる。
;; r*r との差が r 以内のセルだけ打つ(＝輪郭だけ)。
(impl Shape circle
  (label ((self Self)) string "circle")
  (paint ((self Self) (cv canvas)) ()
    (dotimes (dy (+ (* 2 self::r) 1))
      (dotimes (dx (+ (* 4 self::r) 1))
        (let ((ox (- dx (* 2 self::r)))
              (oy (- dy self::r)))
          (when (<= (abs (- (+ (* ox ox) (* 4 (* oy oy))) (* self::r self::r))) self::r)
            (plot cv (+ self::cx ox) (+ self::cy oy) #\*)))))))

(impl Shape hline
  (label ((self Self)) string "hline")
  (paint ((self Self) (cv canvas)) ()
    (dotimes (i self::len)
      (plot cv (+ self::x i) self::y #\=))))

;; An empty Vector<:dyn Shape>. Vector::new takes its element type from the
;; expected type, so the return type annotation is borrowed as the place to give it.
;; 空の Vector<:dyn Shape>。Vector::new は期待型から要素型を決めるので、
;; 型を与える置き場所として戻り型注釈を借りている。
(defun empty-scene () Vector<:dyn Shape>
  (Vector::new))

;; ---- The heart of :dyn -------------------------------------------------
;; ---- ここが :dyn の本題 -------------------------------------------------

;; scene is a single vector mixing rect / circle / hline. Even so, all we write is
;; one (paint s cv), and the vtable decides at run time which implementation runs.
;; scene の中身は rect / circle / hline が混在した1本のベクタ。それでも書くのは
;; (paint s cv) ひとつだけで、どの実装が走るかは実行時に vtable が決める。
(pub defun draw-scene ((cv canvas) (scene Vector<:dyn Shape>)) ()
  (doiter (s (iter scene))
    (paint s cv)))

;; A trait object can be narrowed to a concrete type with match. The set of
;; implementing types is open (more impls may be added later), so the match is never
;; exhaustive and `_` is required.
;; Note also that dynamic dispatch of (label s) and downcasting live side by side in
;; the same body.
;; trait オブジェクトは match で具象型へ落とせる。実装型の集合は開いている
;; (あとから impl が増えうる)ので網羅にはならず、`_` が必須。
;; 同じ本体の中で (label s) の動的ディスパッチと downcast が同居している点にも注目。
(pub defun describe ((s :dyn Shape)) string
  (match s
    ((the circle c) (format false "~a  r=~d at (~d,~d)" (label s) c::r c::cx c::cy))
    ((the rect r) (format false "~a    ~dx~d at (~d,~d)" (label s) r::w r::h r::x r::y))
    (_ (format false "~a   (no downcast arm; label only)" (label s)))))

(pub defun list-scene ((scene Vector<:dyn Shape>)) ()
  (doiter (s (iter scene))
    (println "  - ~a" (describe s))))

;; ---- Parsing: gathering errors of different kinds into :dyn Error ---------
;; ---- パース: 種類の違うエラーを :dyn Error に集める ----------------------

;; Unknown command / wrong number of arguments. There is no further cause to follow,
;; so `source` is not written -- the Error trait's default implementation returns none.
;; 知らないコマンド / 引数の個数違い。これ以上たどる原因は無いので `source` は書かない
;; ——Error トレイトのデフォルト実装が none を返す。
(defstruct bad-command (detail string))
(impl Error bad-command
  (message ((self Self)) string (append "bad command: " self::detail)))

;; An argument that should be an integer could not be read. It wraps the built-in
;; ParseIntError as its cause, so following source reaches the lower-level message
;; (the same as Rust's Error::source).
;; 整数のはずの引数が読めなかった。原因として組み込みの ParseIntError を包むので、
;; source をたどると下位のメッセージまで届く(Rust の Error::source と同じ)。
(defstruct bad-number (word string) (cause ParseIntError))
(impl Error bad-number
  (message ((self Self)) string (append "not a number: " self::word))
  (source ((self Self)) Option<:dyn Error> (option::some self::cause)))

;; Strings have no split, so we cut on whitespace by hand.
;; 文字列に split は無いので空白区切りは自前で刻む。
(defun split-words ((s string)) Vector<string>
  (let ((out (the Vector<string> (Vector::new)))
        (n (length s))
        (i 0))
    (while (< i n)
      (while (and (< i n) (equal (ref s i) #\Space))
        (setf i (+ i 1)))
      (let ((start i))
        (while (and (< i n) (not (equal (ref s i) #\Space)))
          (setf i (+ i 1)))
        (when (> i start)
          (push out (substring s start i)))))
    out))

;; Read all of ws[from..] as integers. If any one fails, stop with bad-number.
;; typelisp has no `?`, so propagating the failure is written out with match.
;; ws[from..] を全部整数として読む。1つでも読めなければ bad-number で打ち切る。
;; typelisp に `?` は無いので、失敗の持ち上げは match で明示的に書く。
(defun scan-nums ((ws Vector<string>) (from int) (acc Vector<int>)) Result<Vector<int>, :dyn Error>
  (if (>= from (len ws))
      (result::ok acc)
      (match (parse-int (get ws from))
        ((ok n) (push acc n) (scan-nums ws (+ from 1) acc))
        ((err e) (result::err (bad-number::new (get ws from) e))))))

;; A concrete type is returned but the return type is :dyn Shape -- implicit coercion
;; applies in return position, so it is boxed without writing (as :dyn Shape ...).
;; 具象型を返しているのに戻り型は :dyn Shape ── 戻り位置は暗黙 coercion が
;; 効くので、(as :dyn Shape ...) と書かなくても箱詰めされる。
(defun build-shape ((kind string) (ns Vector<int>)) Result<:dyn Shape, :dyn Error>
  (cond
    ((and (equal kind "rect") (= (len ns) 4))
     (result::ok (rect::new (get ns 0) (get ns 1) (get ns 2) (get ns 3))))
    ((and (equal kind "circle") (= (len ns) 3))
     (result::ok (circle::new (get ns 0) (get ns 1) (get ns 2))))
    ((and (equal kind "hline") (= (len ns) 3))
     (result::ok (hline::new (get ns 0) (get ns 1) (get ns 2))))
    ;; Both an unknown name and a wrong number of arguments end up here.
    ;; 名前が知らないものだった場合も、引数の個数が合わない場合もここへ落ちる。
    (else (result::err (bad-command::new (format false "~a with ~d args" kind (len ns)))))))

(defun parse-line ((line string)) Result<:dyn Shape, :dyn Error>
  (let ((ws (split-words line)))
    (if (= (len ws) 0)
        (result::err (bad-command::new "(blank line)"))
        (match (scan-nums ws 1 (the Vector<int> (Vector::new)))
          ((ok ns) (build-shape (get ws 0) ns))
          ((err e) (result::err e))))))

(defun collect-scene ((lines Vector<string>) (i int) (scene Vector<:dyn Shape>)) Result<Vector<:dyn Shape>, :dyn Error>
  (if (>= i (len lines))
      (result::ok scene)
      (match (parse-line (get lines i))
        ((ok s) (push scene s) (collect-scene lines (+ i 1) scene))
        ((err e) (result::err e)))))

;; Turn one-shape-per-line descriptions like "circle 11 5 4" into a scene.
;; bad-command and bad-number are different types, but both are :dyn Error, so a
;; single return type is enough.
;; "circle 11 5 4" のような1行1図形の記述をシーンへ。bad-command と bad-number は
;; 別の型だが、どちらも :dyn Error なので戻り型は1つで足りる。
(pub defun parse-scene ((lines Vector<string>)) Result<Vector<:dyn Shape>, :dyn Error>
  (collect-scene lines 0 (empty-scene)))
