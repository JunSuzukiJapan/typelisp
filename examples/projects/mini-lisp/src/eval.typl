;; Evaluation of the syntax tree (lexpr). env is the environment mapping variable
;; names to values (reused for the whole session, and extended by define).
;; 構文木 (lexpr) の評価。env は変数名 -> 値 の環境(セッション全体で使い回し、
;; define で書き加えていく)。
(use ast::lexpr ast::lexpr::*)
;; `eval` is also a standard library function, so this module makes the name its own.
;; `eval` は標準ライブラリの関数の名前でもあるので、このモジュールの名前にする。
(shadow eval)

(pub defun eval ((e lexpr) (env HashTable<string,int>)) int
  (match e
    ((Lit v) v)
    ((Var name) (unwrap (get env name)))
    ((Binop op a b)
     (let ((x (eval a env)))
       (let ((y (eval b env)))
         (cond
           ((equal op "+") (+ x y))
           ((equal op "-") (- x y))
           ((equal op "*") (* x y))
           ((equal op "/") (truncate x y))
           ((equal op "<") (if (< x y) 1 0))
           ((equal op ">") (if (> x y) 1 0))
           ((equal op "=") (if (= x y) 1 0))
           (:else (panic (append "unknown operator: " op)))))))
    ((Iff test then els) (if (/= (eval test env) 0) (eval then env) (eval els env)))
    ((Def name val)
     (let ((v (eval val env)))
       (set env name v)
       v))
    ((Begin es)
     (let ((result 0))
       (doiter (sub (iter es)) (setf result (eval sub env)))
       result))))
