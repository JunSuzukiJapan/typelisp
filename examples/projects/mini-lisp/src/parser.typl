;; Parser: build an lexpr tree from the token sequence (Vector<string>).
;; Nested parentheses are handled directly by parse-expr calling itself. With no
;; mutual recursion, it needs neither labels nor a defsignature.
;; 構文解析: token 列 (Vector<string>) から lexpr の木を組み立てる。
;; 入れ子の丸括弧は parse-expr 自身の再帰呼び出しでそのまま処理できる。
;; 相互再帰が無いので、labels も defsignature も要らない。
(use ast::lexpr)

(pub defstruct cursor
  (toks Vector<string>)
  (pos int))

(defun peek ((c cursor)) string
  (if (>= (pos c) (len (toks c))) ")" (get (toks c) (pos c))))

(defun advance ((c cursor)) string
  (let ((tok (peek c)))
    (setf c::pos (+ (pos c) 1))
    tok))

(pub defun parse-expr ((c cursor)) lexpr
  (let ((tok (advance c)))
    (if (equal tok "(")
        (let ((head (advance c)))
          (cond
            ((equal head "if")
             (let ((test (parse-expr c)))
               (let ((then (parse-expr c)))
                 (let ((els (parse-expr c)))
                   (advance c)
                   (iff test then els)))))
            ((equal head "define")
             (let ((name (advance c)))
               (let ((val (parse-expr c)))
                 (advance c)
                 (def name val))))
            ((equal head "begin")
             (let ((es (the Vector<lexpr> (Vector::new))))
               (while (not (equal (peek c) ")"))
                 (push es (parse-expr c)))
               (advance c)
               (begin es)))
            ((or (equal head "+") (equal head "-") (equal head "*") (equal head "/")
                 (equal head "<") (equal head ">") (equal head "="))
             (let ((a (parse-expr c)))
               (let ((b (parse-expr c)))
                 (advance c)
                 (binop head a b))))
            (else (panic (append "parse error: unknown form `" (append head "`"))))))
        (let ((n (parse-int tok)))
          (if (is-ok n) (lit (unwrap n)) (var tok))))))

(pub defun parse ((toks Vector<string>)) lexpr
  (parse-expr (cursor::new toks 0)))
